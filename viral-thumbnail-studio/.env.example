# Copy this file to .env and fill in your keys.

# OpenAI key — used ONLY for GPT-Image-2 background generation.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# SerpAPI key — used for Google Images background search.
# Get one at: https://serpapi.com/manage-api-key (free tier: 100 searches/month)
SERPAPI_API_KEY=

# Optional: override the image model id (default gpt-image-2).
# IMAGE_MODEL=gpt-image-2

# NOTE: do NOT put an ANTHROPIC_API_KEY here. All Claude calls go through the
# `claude` CLI and bill to your Claude subscription. If the key is set in your
# shell, the app warns and ignores it.
