{
  "id": "before_after",
  "name": "Before / After",
  "description": "Two-state transformation: dull left half, vivid right half, arrow between.",
  "face": {
    "height_frac": 0.72,
    "anchor": "center",
    "x_bleed_px": 0,
    "rim_light": true,
    "drop_shadow": true
  },
  "text": {
    "position": "top",
    "max_words": 4,
    "case": "upper",
    "font": "Anton",
    "start_size": 120,
    "max_lines": 1,
    "fill": "#FFE600",
    "stroke": "#000000",
    "stroke_width": 8,
    "accent_bar": false
  },
  "background": {
    "treatment": "split_desaturate_left",
    "darken": 0.35,
    "shift_x": 0,
    "saturation": 1.25,
    "prompt_style_suffix": "transformation scene, same subject in two states, left dull right vibrant"
  },
  "extras": [
    {
      "type": "arrow",
      "from": [
        0.4,
        0.5
      ],
      "to": [
        0.6,
        0.5
      ],
      "fill": "#FFE600",
      "width": 34
    }
  ]
